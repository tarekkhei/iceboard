@model Icewireless.AccountServiceDashboard.Web.ViewModels.PageViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewBag.ActiveNavKey = Model.ActiveNavKey;
}

<div class="card content-card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <p class="text-uppercase text-muted small mb-1">@Model.Section</p>
                <h2 class="h3">@Model.Title</h2>
                <p class="mb-0 text-secondary">@Model.Description</p>
            </div>
            @if (!Model.QueriesImplemented)
            {
                <span class="badge text-bg-warning">Queries pending</span>
            }
        </div>
        <hr />
        <p class="mb-0">
            This page is part of the clean architecture scaffold. Business metrics and Oracle SELECT statements
            will be added in a subsequent phase. Chart.js is available for future visualizations.
        </p>
        <canvas id="placeholder-chart" class="d-none" height="120" aria-hidden="true"></canvas>
    </div>
</div>
